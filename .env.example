# Copy to .env and fill in for self-hosted deployments.
# Client-side (Vite) — publishable/anon values only, safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side — same URL + publishable key, plus the service role for admin ops.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bootstrap an initial admin user via scripts/install.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web tier
PORT=3000
